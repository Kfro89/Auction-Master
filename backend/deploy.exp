#!/usr/bin/expect -f
set timeout -1
spawn ssh -o PubkeyAuthentication=no -o StrictHostKeyChecking=no kevin@192.168.0.16 "export PATH=/usr/local/bin:/opt/homebrew/bin:\$PATH; cd '/Volumes/10TB HDD 2/Antigravity Workspace/Auction Master' && docker compose up --build -d || docker-compose up --build -d"
expect {
    "*assword:*" {
        send "password\r"
        exp_continue
    }
    eof
}
