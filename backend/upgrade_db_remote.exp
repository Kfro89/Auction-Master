#!/usr/bin/expect -f
set timeout 60
spawn ssh -o PubkeyAuthentication=no -o StrictHostKeyChecking=no kevin@192.168.0.16 "export PATH=/usr/local/bin:/opt/homebrew/bin:\$PATH; cd ~/Docker/AuctionMaster && docker compose exec backend alembic upgrade head"
expect {
    "*assword:*" {
        send "password\r"
        exp_continue
    }
    eof
}
