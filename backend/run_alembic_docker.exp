#!/usr/bin/expect -f
set timeout 30
spawn ssh -o PubkeyAuthentication=no -o StrictHostKeyChecking=no kevin@192.168.0.16 "export PATH=/usr/local/bin:/opt/homebrew/bin:\$PATH; cd '/Volumes/10TB HDD 2/Antigravity Workspace/Auction Master' && docker compose exec backend alembic revision --autogenerate -m 'add search_queries to Item' && docker compose exec backend alembic upgrade head"
expect {
    "*assword:*" {
        send "password\r"
        exp_continue
    }
    eof
}
