#!/usr/bin/expect -f
set timeout -1
spawn ssh -o PubkeyAuthentication=no -o StrictHostKeyChecking=no kevin@192.168.0.16 "export PATH=/usr/local/bin:/opt/homebrew/bin:\$PATH; docker system prune -af --volumes"
expect {
    "*assword:*" {
        send "password\r"
        exp_continue
    }
    eof
}
