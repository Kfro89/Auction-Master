{
  "manifest_version": 3,
  "name": "Auction Master Capture",
  "version": "1.0.0",
  "description": "Automatically captures and syncs auction house session cookies to your local Auction Master instance.",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.publicsurplus.com/*",
    "*://*.dickensheet.com/*",
    "*://*.whitleyauction.com/*",
    "*://*.rollerauction.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}